[sub_resource type="GDScript" id="GDScript_p2q6r"]
script/source = "
@tool
extends Polygon2D

@export_tool_button(\"Test\") var c := func():
	
	var mid_point := Vector2(0., 0.)
	
	for point in polygon:
		mid_point += point
	mid_point /= polygon.size()
	
	offset = -mid_point
	position = mid_point
"

